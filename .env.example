# 环境变量示例 —— 复制为 .env 后按需修改
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会进入版本库，也不会进入演示包。

# ── 可选增强：大模型初评（用于「两阶段智能接入」的自然语言入口）──────────
# 留空则自动跳过初评，由自有模型直接解析与纠正，其余功能不受影响。
# 支持任意 OpenAI 兼容服务（DeepSeek / 通义千问 / 智谱 GLM / OpenAI 等）。
EVENTRADAR_LLM_API_KEY=
# 接口地址（默认 DeepSeek）
EVENTRADAR_LLM_BASE_URL=https://api.deepseek.com/v1
# 模型名（默认 deepseek-chat）
EVENTRADAR_LLM_MODEL=deepseek-chat

# ── 运行环境 ─────────────────────────────────────────────────────────
# 向量化设备：cuda / cpu（配置为 cuda 但不可用时会自动回退 cpu）
EVENTRADAR_EMBEDDING_DEVICE=cpu
# 设为 0 可关闭启动预热（数据缓存 / 增量索引 / 两阶段模型）
# EVENTRADAR_WARMUP=1
